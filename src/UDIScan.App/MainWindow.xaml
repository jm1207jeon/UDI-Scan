<Window x:Class="UDIScan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="UDI-Scan - Zebra DS9908 Barcode Scanner"
        Height="650" Width="900"
        MinHeight="600" MinWidth="800"
        Background="{StaticResource BackgroundColor}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Scanner Status -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12"
                         Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"
                         Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ScannerStatus}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Scan History -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceColor}"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Scan History"
                               Style="{StaticResource HeaderTextStyle}"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ScanHistory}"
                             Style="{StaticResource ModernListBoxStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding FormattedScanTime}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Barcode}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding BarcodeType}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2"
                            Content="Clear History"
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding ClearHistoryCommand}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- Right Panel: Image Preview -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceColor}"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Last Captured Image"
                               Style="{StaticResource HeaderTextStyle}"/>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Image Source="{Binding LastCapturedImage}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <Trigger Property="Source" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Border>

                    <!-- Placeholder text when no image -->
                    <TextBlock Grid.Row="1"
                               Text="No image captured yet"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastCapturedImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings Panel -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8"
                Padding="16"
                Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Image Capture Toggle -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Image Capture:"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ToggleButton IsChecked="{Binding IsImageCaptureEnabled}"
                                  Style="{StaticResource ModernToggleButtonStyle}"
                                  Width="100">
                        <ToggleButton.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Disabled"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImageCaptureEnabled}" Value="True">
                                                <Setter Property="Text" Value="Enabled"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToggleButton.Content>
                    </ToggleButton>
                </StackPanel>

                <!-- Save Path -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Save Path:"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding ImageSavePath, Mode=TwoWay}"
                             IsReadOnly="True"
                             Background="{StaticResource BackgroundColor}"
                             BorderBrush="{StaticResource BorderColor}"
                             Padding="8"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0"/>

                    <Button Grid.Column="2"
                            Content="Browse..."
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding SelectSavePathCommand}"
                            Width="100"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8"
                Padding="12"
                Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondary}"/>
        </Border>
    </Grid>
</Window>
